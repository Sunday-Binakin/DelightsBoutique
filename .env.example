# Base URL of the backend API. No trailing slash.
# Local dev (.NET 8 backend, self-signed dev cert):
NEXT_PUBLIC_API_URL=https://localhost:7046

# Server-side fetches (sitemap, product metadata) run in Node, which doesn't trust the
# .NET dev certificate by default. Export it as PEM (`dotnet dev-certs https --export-path`,
# then `openssl pkcs12 -in dev.pfx -nokeys -clcerts -out dev-cert.pem`) and set, in the
# shell that runs `npm run build`, `npm run dev` or `next start`:
#   NODE_EXTRA_CA_CERTS=/path/to/dev-cert.pem
# The sitemap is generated at build time, so the build needs it too.
#
# Deployed: point this at the deployed backend's URL instead — no code changes required.
